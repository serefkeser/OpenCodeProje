# ============================================================================
# OTONOM — .env ÖRNEK ŞABLON
# ============================================================================
# KULLANIM:
#   1) Bu dosyayı `.env` adıyla kopyalayın  (Mac: cp .env.example .env)
#   2) Sadece 5 API anahtarını (API_KEY ile biten satırlar) kendi anahtarlarınızla doldurun.
#   3) `.env` ASLA git'e commit edilmez (.gitignore içinde); anahtarlarınız yalnız sizde kalır.
#
# Port ve model satırları önceden dolduruldu — bilinen anahtarlar için dokunmayın.
# Sıfır maliyet: program mevcut ücretsiz anahtarlarla (Gemini/OpenRouter/Groq/NVIDIA)
# çalışır; üretime sunulan hiçbir bileşen ücretli değildir.
# ============================================================================

# --- API ANAHTARLARI (ZORUNLU — kendi ücretsiz anahtarlarınızı girin) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENCODE_API_KEY=

# --- PORTLAR (boş olmalı; 4100/4201/4202/5173 bu makinede boş olmalı) ---
WEB_PORT=5173
GATEWAY_PORT=4100
ANALYSIS_PORT=4201
MEDIA_PORT=4202

# --- MODEL ADLARI (önceden dolduruldu; değiştirmeniz gerekmez) ---
OPENROUTER_TEXT_MODEL=openai/gpt-oss-120b
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
GROQ_TEXT_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.6-27b
NVIDIA_TEXT_MODEL=minimaxai/minimax-m3.1-flash
NVIDIA_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
OPENCODE_TEXT_MODEL=gpt-5.6-sol
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Aoede

# --- MÜZİK KAYNAK KLASÖRÜ (isteğe bağlı) ---
# Müzik aktarımını uygulama içinde "MÜZİK KLASÖRÜ SEÇ" düğmesiyle de yapabilirsiniz;
# seçtiğiniz müzikler gateway'in kalıcı disk deposuna (services/gateway/muzik/) yazılır.
# Örnek Mac: MUSIC_DIR=/Users/sizinadiniz/Downloads/Muzik
# Örnek Windows: MUSIC_DIR=C:\Users\sizinadiniz\Downloads\Muzik
MUSIC_DIR=
